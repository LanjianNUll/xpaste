{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "Xpaste",
  "version": "2.0.11",
  "identifier": "com.paste.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Xpaste",
        "width": 980,
        "height": 720,
        "resizable": true,
        "skipTaskbar": true,
        "decorations": false
      },
      {
        "label": "popup",
        "title": "Paste Quick",
        "url": "popup.html",
        "width": 360,
        "height": 500,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwOUVDRTVCOThDQzk2OUIKUldTYmxzeVlXODZlWUZLUzNRS3hhd0ZFc1czcDRIVGNqUDYxa0J6Y2NsOXc0Znp4OTZSM09vbXcK",
      "endpoints": [
        "https://github.com/LanjianNUll/xpaste/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
